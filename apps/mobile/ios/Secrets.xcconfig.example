// Copy this file to Secrets.xcconfig (same directory) and fill in real values.
// Secrets.xcconfig is gitignored — never commit it.
//
// GOOGLE_IOS_CLIENT_ID: an "iOS" OAuth client in Google Cloud Console (APIs & Services
// -> Credentials), registered for the bundle id below. Not the Mac's Desktop client.
GOOGLE_IOS_CLIENT_ID = REPLACE_ME

// PRODUCT_BUNDLE_IDENTIFIER (optional): overrides Base.xcconfig's com.mpointer.whimbrel.mobile.
// Leave it unset for TestFlight builds; the upload script refuses any other id.
// PRODUCT_BUNDLE_IDENTIFIER = com.mpointer.whimbrel.mobile

// SYNC_WORKER_BASE_URL (optional): overrides Base.xcconfig's deployed Worker, e.g. a local
// `wrangler dev`. Write "//" as "/$()/" (xcconfig treats "//" as a comment).
// SYNC_WORKER_BASE_URL = http:/$()/localhost:8787
