# Sync configuration for the Windows app (docs/superpowers/plans/2026-09-10-m3.2-shell-skeleton.md,
# Decision 6). Copy to Secrets.toml (gitignored) and fill in. The values are the same ones
# apps/macos/Secrets.xcconfig holds: Windows reuses the Mac's Google desktop OAuth client,
# because the sync Worker verifies ID tokens against a single GOOGLE_CLIENT_ID.
#
# The file is read at build time; rebuild after changing it. Without it the app runs and
# Settings → Sync says "not configured".

sync_worker_base_url = "https://kestrel-sync-worker.example.workers.dev"
google_oauth_client_id = "000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
google_oauth_client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
