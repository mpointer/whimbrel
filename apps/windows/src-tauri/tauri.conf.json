{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whimbrel",
  "version": "0.9.35",
  "identifier": "com.mpointer.kestrel",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whimbrel",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../skins/*.json": "skins/",
      "../../../skins/palettes/*.json": "skins/palettes/",
      "../../../themes/*.json": "themes/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMkExNThGNTU2Q0YxMkYKUldRdjhXeFZqeFVxSWVWT3YzTlpjSFhnaXlLNFZpYzkrNHorb3o5YmtiZ0VHUzgyUnpkQ0VkTGcK",
      "endpoints": [
        "https://updates.whimbrelapp.com/windows/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
