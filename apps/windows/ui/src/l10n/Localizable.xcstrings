          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{bytes} de grabaciones están en calidad completa. Al comprimirlas se conservan para volver a transcribirlas, con aproximadamente una décima parte del tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
