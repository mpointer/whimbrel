        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für Meetings in anderen Sprachen werden {models} (ca. {size} MB) benötigt, einmalig heruntergeladen. Bis dahin werden Meetings als Englisch transkribiert. Audio verlässt diesen PC nie."
          }
        },
        "es" : {
          "stringUnit" : {
