    "The memory database file looks damaged, so Whimbrel cannot open it. Whimbrel has not changed it and will not delete or replace it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Datei der Gedächtnisdatenbank scheint beschädigt zu sein, daher kann Whimbrel sie nicht öffnen. Whimbrel hat sie nicht verändert und wird sie weder löschen noch ersetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El archivo de la base de datos de memoria parece dañado, así que Whimbrel no puede abrirlo. Whimbrel no lo ha modificado y no lo eliminará ni lo reemplazará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le fichier de la base de données de mémoire semble endommagé ; Whimbrel ne peut donc pas l’ouvrir. Whimbrel ne l’a pas modifié et ne le supprimera ni ne le remplacera."
          }
