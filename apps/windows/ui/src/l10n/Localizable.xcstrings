          }
        }
      }
    },
    "This draft couldn't be read. You can reject it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Entwurf konnte nicht gelesen werden. Sie können ihn ablehnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo leer este borrador. Puedes rechazarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
