    "This doesn't change how long Whimbrel keeps data, and never touches a meeting being recorded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das ändert nicht, wie lange Whimbrel Daten aufbewahrt, und berührt nie ein Meeting, das gerade aufgenommen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto no cambia cuánto tiempo guarda Whimbrel los datos y nunca toca una reunión que se está grabando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cela ne change pas la durée de conservation des données par Whimbrel et ne touche jamais une réunion en cours d’enregistrement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
