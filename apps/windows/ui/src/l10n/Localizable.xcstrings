    "Gives search up to 1 GB of extra memory. Takes effect after you restart Whimbrel, and only applies once the memory database is encrypted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gibt der Suche bis zu 1 GB zusätzlichen Arbeitsspeicher. Wirkt nach einem Neustart von Whimbrel und nur, wenn die Gedächtnisdatenbank verschlüsselt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da a la búsqueda hasta 1 GB de memoria adicional. Se aplica después de reiniciar Whimbrel y solo cuando la base de datos de memoria esté cifrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accorde jusqu’à 1 Go de mémoire supplémentaire à la recherche. Prend effet après le redémarrage de Whimbrel, et uniquement une fois la base de données de mémoire chiffrée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accorde jusqu’à 1 Go de mémoire supplémentaire à la recherche. Prend effet après le redémarrage de Whimbrel, et uniquement une fois la base de données de mémoire chiffrée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dá à busca até 1 GB de memória extra. Entra em vigor depois que você reiniciar o Whimbrel e só se aplica quando o banco de dados de memória estiver criptografado."
          }
        }
      }
    },
