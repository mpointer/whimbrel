    "Another pending device shows the same code — don't approve it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein anderes ausstehendes Gerät zeigt denselben Code an – nicht genehmigen"
