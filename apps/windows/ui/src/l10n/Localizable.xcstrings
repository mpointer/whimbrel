    "A client can reappear as a new topic if new mail or a new meeting matches it." : {
      "comment" : "Client controls (X6). Delete screen and receipt.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Kunde kann als neues Thema wieder auftauchen, wenn neue E-Mails oder ein neues Meeting dazu passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un cliente puede reaparecer como tema nuevo si un correo nuevo o una reunión nueva coinciden con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un client peut réapparaître comme nouveau sujet si un nouvel e-mail ou une nouvelle réunion correspond."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
