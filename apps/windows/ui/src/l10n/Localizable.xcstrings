    "A small model runs on this PC with no account. Answers are slower and plainer than a hosted model's. It needs about 1.9 GB." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein kleines Modell läuft ohne Konto auf diesem PC. Antworten sind langsamer und einfacher als bei einem gehosteten Modell. Es braucht etwa 1,9 GB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un modelo pequeño funciona en este PC sin cuenta. Las respuestas son más lentas y sencillas que las de un modelo alojado. Necesita unos 1,9 GB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
