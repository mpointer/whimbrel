    "Whimbrel could not work out what its daily cleanup would delete: {error}" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel konnte nicht ermitteln, was die tägliche Bereinigung löschen würde: {error}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
