    "Approved, but the key handoff expired. On your Mac, open Settings → Devices, choose Re-send Key for this PC, then Check Again here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Genehmigt, aber die Schlüsselübergabe ist abgelaufen. Öffnen Sie auf Ihrem Mac Einstellungen → Geräte, wählen Sie „Schlüssel erneut senden“ für diesen PC und dann hier „Erneut prüfen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprobado, pero la entrega de la clave expiró. En tu Mac, abre Ajustes → Dispositivos, elige Reenviar clave para esta PC y luego toca Comprobar de nuevo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Approuvé, mais le transfert de la clé a expiré. Sur votre Mac, ouvrez Paramètres → Appareils, choisissez Renvoyer la clé pour ce PC, puis Vérifier à nouveau ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Approuvé, mais le transfert de la clé a expiré. Sur votre Mac, ouvrez Réglages → Appareils, choisissez Renvoyer la clé pour ce PC, puis touchez Vérifier à nouveau ici."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aprovado, mas a transferência da chave expirou. No seu Mac, abra Configurações → Dispositivos, escolha Reenviar chave para este PC e depois toque em Verificar novamente aqui."
          }
        }
      }
    },
