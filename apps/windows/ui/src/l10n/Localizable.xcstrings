    "This Whimbrel Cloud is already on your account. To add it again, remove it from the list, run its setup again and paste the new key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Whimbrel Cloud ist bereits in Ihrem Account. Um sie erneut hinzuzufügen, entfernen Sie sie aus der Liste, führen Sie die Einrichtung erneut aus und fügen Sie den neuen Schlüssel ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este Whimbrel Cloud ya está en tu cuenta. Para agregarlo de nuevo, quítalo de la lista, ejecuta su configuración otra vez y pega la clave nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
