        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun appareil à jour n'attend encore d'appliquer cette suppression. Un appareil sous une version plus ancienne, ou un appareil que vous avez retiré du décompte dans les Paramètres, peut ne pas l'avoir appliquée."
          }
