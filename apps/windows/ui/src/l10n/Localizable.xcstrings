    "Whimbrel detects each meeting's language and transcribes it as spoken, using a larger multilingual model. Off, every meeting is transcribed as English." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel erkennt die Sprache jedes Meetings und transkribiert sie wie gesprochen, mit einem größeren mehrsprachigen Modell. Ist die Option aus, wird jedes Meeting als Englisch transkribiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel detecta el idioma de cada reunión y la transcribe tal como se habla, con un modelo multilingüe más grande. Si está desactivado, todas las reuniones se transcriben como inglés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel détecte la langue de chaque réunion et la transcrit telle qu'elle est parlée, avec un modèle multilingue plus volumineux. Désactivé, toutes les réunions sont transcrites en anglais."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel détecte la langue de chaque réunion et la transcrit telle qu’elle est parlée, à l’aide d’un modèle multilingue plus volumineux. Désactivé, chaque réunion est transcrite en anglais."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Whimbrel detecta o idioma de cada reunião e a transcreve como foi falada, usando um modelo multilíngue maior. Desativado, todas as reuniões são transcritas em inglês."
          }
        }
      }
    },
