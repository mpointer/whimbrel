          }
        }
      }
    },
    "The copy could not be put back, and some files may have moved. Try again, or quit and write to hello@whimbrelapp.com." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Kopie konnte nicht zurückgelegt werden, und einige Dateien wurden möglicherweise verschoben. Versuchen Sie es erneut, oder beenden Sie Whimbrel und schreiben Sie an hello@whimbrelapp.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo restaurar la copia y es posible que algunos archivos se hayan movido. Vuelve a intentarlo o sal y escribe a hello@whimbrelapp.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La copie n’a pas pu être remise en place, et certains fichiers ont peut-être été déplacés. Réessayez, ou quittez Whimbrel et écrivez à hello@whimbrelapp.com."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La copie n’a pas pu être remise en place, et certains fichiers ont peut-être été déplacés. Réessayez, ou quittez Whimbrel et écrivez à hello@whimbrelapp.com."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível restaurar a cópia, e alguns arquivos podem ter sido movidos. Tente novamente ou saia e escreva para hello@whimbrelapp.com."
          }
        }
      }
    },
    "The copy could not be put back. Nothing was changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Kopie konnte nicht zurückgelegt werden. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
