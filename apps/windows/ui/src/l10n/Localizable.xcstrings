          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel n’a pas pu déterminer ce que son nettoyage quotidien supprimerait : {error}"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
