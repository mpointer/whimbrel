    "Off skips Ollama entirely. Turn it off on a PC that does not run Ollama, so calls stop trying to reach it first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bei „Aus“ wird Ollama komplett übersprungen. Schalten Sie es auf einem PC aus, auf dem Ollama nicht läuft, damit Aufrufe nicht zuerst versuchen, es zu erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si lo desactivas, se omite Ollama por completo. Desactívalo en una PC que no ejecute Ollama para que las llamadas dejen de intentar conectarse a él primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivé : Ollama est totalement ignoré. Désactivez-le sur un PC qui n'exécute pas Ollama, pour que les appels cessent d'essayer de l'atteindre en premier."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivé, Ollama est complètement ignoré. Désactivez-le sur un PC qui n’exécute pas Ollama, afin que les appels cessent de tenter de l’joindre en premier."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desativado ignora o Ollama por completo. Desative em um PC que não executa o Ollama, para que as chamadas parem de tentar acessá-lo primeiro."
          }
        }
      }
    },
