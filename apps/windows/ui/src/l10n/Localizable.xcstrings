    "On, but waiting: nothing happens until your Profile has a field or a fact." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein, aber wartend: Es passiert nichts, bis Ihr Profil ein Feld oder einen Fakt enthält."
          }
        },
        "es" : {
          "stringUnit" : {
