    "Copies your devices sent to the sync relay before this version stay there, encrypted. Current devices ignore them." : {
      "comment" : "Client controls (X6, Task 11; the Mac's Task 10 wording, with this PC's facts).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopien, die Ihre Geräte vor dieser Version an das Sync-Relay gesendet haben, bleiben dort verschlüsselt erhalten. Aktuelle Geräte ignorieren sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las copias que tus dispositivos enviaron al relé de sincronización antes de esta versión permanecen allí, cifradas. Los dispositivos actuales las ignoran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les copies que vos appareils ont envoyées au relais de synchronisation avant cette version y restent, chiffrées. Les appareils actuels les ignorent."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les copies que vos appareils ont envoyées au relais de synchronisation avant cette version y restent, chiffrées. Les appareils à jour les ignorent."
          }
        },
        "pt" : {
