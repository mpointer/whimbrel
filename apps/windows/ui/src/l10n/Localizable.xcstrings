          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reuniões em outros idiomas precisam de {models} (cerca de {size} MB), baixados uma única vez. Até lá, as reuniões são transcritas em inglês. O áudio nunca sai deste PC."
