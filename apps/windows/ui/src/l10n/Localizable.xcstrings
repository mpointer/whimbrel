            "value" : "Ollama läuft auf diesem Computer nicht. Starten Sie Ollama, oder wählen Sie Whimbrel AI bzw. fügen Sie einen API-Schlüssel unter Einstellungen → KI hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama no se está ejecutando en esta computadora. Inicia Ollama, o elige Whimbrel AI o agrega una clave de API en Ajustes → IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama n’est pas en cours d’exécution sur cet ordinateur. Lancez Ollama, ou choisissez Whimbrel AI ou ajoutez une clé d’API dans Réglages → IA."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama n’est pas en cours d’exécution sur cet ordinateur. Lancez Ollama, ou choisissez Whimbrel AI ou ajoutez une clé d’API dans Réglages → IA."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Ollama não está em execução neste computador. Inicie o Ollama, ou escolha Whimbrel AI ou adicione uma chave de API em Configurações → IA."
          }
        }
      }
    },
    "On" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein"
          }
        },
        "es" : {
          "stringUnit" : {
