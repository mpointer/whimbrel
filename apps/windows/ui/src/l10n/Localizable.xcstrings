    "Sends short excerpts of emails, meetings, calendar events and screen activity to TypeSafe to choose a topic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sendet kurze Auszüge aus E-Mails, Meetings, Kalenderterminen und Bildschirmaktivität an TypeSafe, um ein Thema zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía fragmentos breves de correos, reuniones, eventos del calendario y actividad de pantalla a TypeSafe para elegir un tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoie de courts extraits de courriels, de réunions, d’événements d’agenda et d’activité à l’écran à TypeSafe pour choisir un sujet."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoie de courts extraits de courriels, de réunions, d’événements de calendrier et d’activité à l’écran à TypeSafe pour choisir un sujet."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envia trechos curtos de e-mails, reuniões, eventos da agenda e atividade da tela ao TypeSafe para escolher um tópico."
          }
        }
      }
    },
    "Sends short excerpts of topic emails, meeting action items and Teams screens to TypeSafe to find steps you owe and are owed. Off: your local model does this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet kurze Auszüge aus E-Mails zu Themen, Meeting-Aufgaben und Teams-Bildschirmen an TypeSafe, um Ihre Zusagen und Zusagen an Sie zu finden. Aus: Ihr lokales Modell übernimmt das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía fragmentos breves de correos de los temas, tareas pendientes de reuniones y pantallas de Teams a TypeSafe para encontrar lo que debes y lo que te deben. Desactivado: lo hace tu modelo local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie de courts extraits des e-mails liés aux sujets, des actions à mener des réunions et des écrans Teams à TypeSafe pour trouver vos engagements et ceux envers vous. Désactivé : votre modèle local s’en charge."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie de courts extraits des courriels liés aux sujets, des tâches à faire des réunions et des écrans Teams à TypeSafe pour trouver vos engagements et ceux envers vous. Désactivé : votre modèle local s’en charge."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia trechos curtos de e-mails dos tópicos, itens de ação de reuniões e telas do Teams ao TypeSafe para encontrar o que você deve e o que devem a você. Desligado: seu modelo local faz isso."
          }
        }
      }
    },
