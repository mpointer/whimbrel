    "Use the cheapest model for small tasks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für kleine Aufgaben das günstigste Modell verwenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usar el modelo más económico para tareas pequeñas"
          }
        },
        "fr" : {
          "stringUnit" : {
