          }
        }
      }
    },
    "Whimbrel couldn't make that skin, so nothing changed. Try again or say it another way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel konnte diesen skin nicht erstellen, nichts wurde geändert. Versuchen Sie es erneut oder anders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel no pudo crear ese skin, así que no cambió nada. Inténtalo de nuevo o dilo de otra manera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel n'a pas pu créer ce skin, donc rien n'a changé. Réessayez ou reformulez votre demande."
