    "Whimbrel {version} is ready. Restarting installs it and reopens Whimbrel. It waits while a meeting is being recorded or processed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel {version} ist bereit. Ein Neustart installiert es und öffnet Whimbrel wieder. Er wartet, solange ein Meeting aufgenommen oder verarbeitet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel {version} está listo. Al reiniciar se instala y Whimbrel vuelve a abrirse. Espera mientras se graba o se procesa una reunión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
