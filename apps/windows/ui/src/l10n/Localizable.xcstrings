    "Removes your meetings, memory, recordings and logs from this PC. Your settings (settings.json), downloaded models and API keys stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt Ihre Meetings, Ihr Gedächtnis, Ihre Aufnahmen und Protokolle von diesem PC. Ihre Einstellungen (settings.json), heruntergeladene Modelle und API-Schlüssel bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quita de esta PC tus reuniones, memoria, grabaciones y registros. Se conservan tus ajustes (settings.json), los modelos descargados y las claves de API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime vos réunions, votre mémoire, vos enregistrements et vos journaux de ce PC. Vos paramètres (settings.json), les modèles téléchargés et les clés API sont conservés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime vos réunions, votre mémoire, vos enregistrements et vos journaux de ce PC. Vos paramètres (settings.json), les modèles téléchargés et les clés API sont conservés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remove suas reuniões, memória, gravações e logs deste PC. Suas configurações (settings.json), modelos baixados e chaves de API permanecem."
          }
        }
      }
    },
