          }
        }
      }
    },
    "This PC already has an encryption key from an earlier attempt. Encrypting the database uses it, so recovery words you kept for it still work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser PC hat bereits einen Verschlüsselungsschlüssel aus einem früheren Versuch. Die Datenbankverschlüsselung verwendet ihn, daher funktionieren Wiederherstellungswörter, die Sie dafür aufbewahrt haben, weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta PC ya tiene una clave de cifrado de un intento anterior. Al cifrar la base de datos se usa esa clave, así que las palabras de recuperación que guardaste para ella siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce PC possède déjà une clé de chiffrement issue d’une tentative précédente. Le chiffrement de la base de données l’utilise ; les mots de récupération que vous avez conservés pour elle fonctionnent donc toujours."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce PC possède déjà une clé de chiffrement issue d’une tentative précédente. Le chiffrement de la base de données l’utilise ; les mots de récupération que vous avez conservés pour elle fonctionnent donc toujours."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este PC já tem uma chave de criptografia de uma tentativa anterior. A criptografia do banco de dados a usa, então as palavras de recuperação que você guardou para ela continuam funcionando."
          }
        }
      }
    },
    "This PC doesn't hold the account key yet, so it can't approve other devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser PC besitzt den Kontoschlüssel noch nicht und kann daher keine anderen Geräte genehmigen."
