    },
    "A morning summary of yesterday, and a look at today's calendar. It reads your captures and meeting summaries. Uses the AI you chose in Settings, so a hosted model sees it unless Local-only is on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Morgenzusammenfassung von gestern und ein Blick auf den heutigen Kalender. Sie liest Ihre Aufnahmen und Meeting-Zusammenfassungen. Nutzt die in den Einstellungen gewählte KI, sodass ein gehostetes Modell die Inhalte sieht, sofern „Nur lokal“ nicht aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un resumen matutino de ayer y un vistazo al calendario de hoy. Lee tus capturas y los resúmenes de tus reuniones. Usa la IA que elegiste en Ajustes, así que un modelo alojado lo verá a menos que el modo Solo local esté activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un résumé matinal de la veille et un aperçu de l'agenda du jour. Il lit vos captures et résumés de réunion. Utilise l'IA choisie dans les paramètres : un modèle hébergé les voit donc, sauf si « Local uniquement » est activé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un résumé matinal de la veille et un aperçu du calendrier d'aujourd'hui. Il lit vos captures et vos résumés de réunion. Utilise l'IA choisie dans les paramètres : un modèle hébergé les voit donc, à moins que « Local uniquement » ne soit activé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um resumo matinal de ontem e uma visão da agenda de hoje. Ele lê suas capturas e resumos de reuniões. Usa a IA que você escolheu em Configurações, então um modelo hospedado a vê, a menos que o modo Somente local esteja ativado."
          }
        }
      }
    },
    "A new folder applies to meetings recorded from now on. Earlier meetings keep theirs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein neuer Ordner gilt für Meetings, die ab jetzt aufgenommen werden. Frühere Meetings behalten ihren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una carpeta nueva se aplica a las reuniones que grabes a partir de ahora. Las reuniones anteriores conservan la suya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un nouveau dossier s'applique aux réunions enregistrées à partir de maintenant. Les réunions précédentes conservent le leur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un nouveau dossier s’applique aux réunions enregistrées à partir de maintenant. Les réunions antérieures conservent le leur."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma nova pasta vale para as reuniões gravadas a partir de agora. As reuniões anteriores mantêm a delas."
          }
        }
      }
    },
    "A routine result" : {
      "localizations" : {
