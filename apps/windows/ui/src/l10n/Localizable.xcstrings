    "If it is interrupted, Whimbrel finishes or undoes it the next time it starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird sie unterbrochen, schließt Whimbrel sie beim nächsten Start ab oder macht sie rückgängig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si se interrumpe, Whimbrel lo termina o lo deshace la próxima vez que se inicie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’il est interrompu, Whimbrel le termine ou l’annule au prochain démarrage."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "S’il est interrompu, Whimbrel le termine ou l’annule au prochain démarrage."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se for interrompida, o Whimbrel a conclui ou desfaz na próxima vez que for iniciado."
          }
        }
      }
    },
    "If you have a backup of the memory database, quit Whimbrel, put the backup back, and open Whimbrel again. If not, use Reset. For help, write to hello@whimbrelapp.com." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn Sie eine Sicherung der Gedächtnisdatenbank haben, beenden Sie Whimbrel, legen Sie die Sicherung zurück und öffnen Sie Whimbrel erneut. Wenn nicht, verwenden Sie Zurücksetzen. Hilfe erhalten Sie unter hello@whimbrelapp.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si tienes una copia de seguridad de la base de datos de memoria, sal de Whimbrel, vuelve a colocar la copia y abre Whimbrel de nuevo. Si no, usa Restablecer. Si necesitas ayuda, escribe a hello@whimbrelapp.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si vous avez une sauvegarde de la base de données de mémoire, quittez Whimbrel, remettez la sauvegarde en place, puis rouvrez Whimbrel. Sinon, utilisez Réinitialiser. Pour obtenir de l’aide, écrivez à hello@whimbrelapp.com."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si vous avez une sauvegarde de la base de données de mémoire, quittez Whimbrel, remettez la sauvegarde en place, puis rouvrez Whimbrel. Sinon, utilisez Réinitialiser. Pour obtenir de l’aide, écrivez à hello@whimbrelapp.com."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se você tiver um backup do banco de dados de memória, saia do Whimbrel, restaure o backup e abra o Whimbrel novamente. Caso contrário, use Redefinir. Para obter ajuda, escreva para hello@whimbrelapp.com."
          }
        }
      }
    },
