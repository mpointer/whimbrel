      }
    },
    "The memory database is an ordinary file on this PC. Encrypting it makes a copy of the file unreadable without a key kept in Windows Credential Manager." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Gedächtnisdatenbank ist eine gewöhnliche Datei auf diesem PC. Durch die Verschlüsselung ist eine Kopie der Datei ohne einen Schlüssel aus der Windows-Anmeldeinformationsverwaltung nicht lesbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La base de datos de memoria es un archivo normal en esta PC. Al cifrarla, una copia del archivo no se puede leer sin una clave guardada en el Administrador de credenciales de Windows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La base de données de mémoire est un fichier ordinaire sur ce PC. La chiffrer rend toute copie du fichier illisible sans une clé conservée dans le Gestionnaire d’identifiants Windows."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
