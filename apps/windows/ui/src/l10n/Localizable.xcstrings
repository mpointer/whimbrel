    "A Gmail thread summary may keep text from mail in that thread that already expired from Whimbrel." : {
      "comment" : "Client controls (X6, Task 11; the Mac's Task 10 wording, with this PC's facts).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Zusammenfassung eines Gmail-Threads kann Text aus E-Mails dieses Threads enthalten, die in Whimbrel bereits abgelaufen sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El resumen de un hilo de Gmail puede conservar texto de correos de ese hilo que ya expiraron en Whimbrel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le résumé d'un fil Gmail peut conserver du texte de messages de ce fil qui ont déjà expiré dans Whimbrel."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le résumé d'un fil Gmail peut conserver du texte de courriels de ce fil qui ont déjà expiré dans Whimbrel."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O resumo de uma conversa do Gmail pode conter texto de e-mails dessa conversa que já expiraram no Whimbrel."
          }
        }
      }
    },
