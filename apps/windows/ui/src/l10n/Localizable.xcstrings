            "state" : "needs_review",
            "value" : "Whimbrel no encuentra la base de datos de memoria"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel ne trouve pas la base de données de mémoire"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel ne trouve pas la base de données de mémoire"
          }
        },
        "pt" : {
