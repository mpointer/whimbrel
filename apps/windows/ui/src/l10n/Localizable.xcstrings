    "Activity capture is off for now and any recording was stopped. A meeting Whimbrel was still processing carries on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Aktivitätserfassung ist vorerst aus, und laufende Aufnahmen wurden beendet. Ein Meeting, das Whimbrel noch verarbeitet hat, wird weiter verarbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La captura de actividad está desactivada por ahora y se detuvo cualquier grabación. Si Whimbrel aún estaba procesando una reunión, el procesamiento continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La capture d’activité est désactivée pour l’instant et tout enregistrement en cours a été arrêté. Le traitement d’une réunion que Whimbrel avait déjà commencé se poursuit."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La capture d’activité est désactivée pour l’instant et tout enregistrement en cours a été arrêté. Le traitement d’une réunion que Whimbrel avait déjà commencé se poursuit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A captura de atividade está desativada por enquanto e qualquer gravação foi interrompida. Uma reunião que o Whimbrel ainda estava processando continua."
          }
        }
      }
    },
