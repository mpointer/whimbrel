    "Local-only mode is on: every request goes to Ollama on this PC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Nur-lokal-Modus ist aktiv: Jede Anfrage geht an Ollama auf diesem PC."
          }
        },
        "es" : {
