    "Please attach {file}, the diagnostics file Whimbrel just saved (File Explorer has it selected). It has recent logs and settings status, with email addresses and meeting titles removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bitte hängen Sie {file} an, die Diagnosedatei, die Whimbrel gerade gespeichert hat (im Datei-Explorer ausgewählt). Sie enthält aktuelle Protokolle und den Einstellungsstatus, ohne E-Mail-Adressen und Besprechungstitel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adjunta {file}, el archivo de diagnóstico que Whimbrel acaba de guardar (está seleccionado en el Explorador de archivos). Contiene registros recientes y el estado de la configuración, sin direcciones de correo ni títulos de reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veuillez joindre {file}, le fichier de diagnostic que Whimbrel vient d'enregistrer (sélectionné dans l'Explorateur de fichiers). Il contient les journaux récents et l'état des réglages, sans adresses e-mail ni titres de réunion."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veuillez joindre {file}, le fichier de diagnostic que Whimbrel vient d'enregistrer (sélectionné dans l'Explorateur de fichiers). Il contient les journaux récents et l'état des paramètres, sans adresses courriel ni titres de réunion."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anexe {file}, o arquivo de diagnóstico que o Whimbrel acabou de salvar (está selecionado no Explorador de Arquivos). Ele tem registros recentes e o estado das configurações, sem endereços de e-mail nem títulos de reuniões."
          }
        }
      }
    },
