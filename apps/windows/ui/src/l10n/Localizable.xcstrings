    "A meeting is being recorded. Delete everything stops the recording first, and the meeting is deleted with the rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Meeting wird gerade aufgenommen. „Alles löschen“ beendet zuerst die Aufnahme, und das Meeting wird mit allem anderen gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
