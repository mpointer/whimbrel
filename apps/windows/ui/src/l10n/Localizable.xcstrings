    "This removes this account's Calendar events from this PC and revokes Whimbrel's access to the account with Google. Meetings you recorded are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Kalendertermine dieses Kontos von diesem PC entfernt, und der Zugriff von Whimbrel auf das Konto wird bei Google widerrufen. Von Ihnen aufgezeichnete Besprechungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita los eventos de calendario de esta cuenta de esta PC y revoca ante Google el acceso de Whimbrel a la cuenta. Las reuniones que grabaste se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les événements d’agenda de ce compte de ce PC et révoque auprès de Google l’accès de Whimbrel au compte. Les réunions que vous avez enregistrées sont conservées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les événements d’agenda de ce compte de ce PC et révoque auprès de Google l’accès de Whimbrel au compte. Les réunions que vous avez enregistrées sont conservées."
          }
        },
        "pt" : {
          "stringUnit" : {
