    "A routine that would send or add something waits for your approval first, unless you turn on approving it automatically for that routine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Routine, die etwas senden oder hinzufügen würde, wartet zuerst auf Ihre Genehmigung, es sei denn, Sie aktivieren für diese Routine die automatische Genehmigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una rutina que enviaría o agregaría algo espera primero tu aprobación, a menos que actives la aprobación automática para esa rutina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une routine qui enverrait ou ajouterait quelque chose attend d'abord votre approbation, sauf si vous activez l'approbation automatique pour cette routine."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une routine qui enverrait ou ajouterait quelque chose attend d’abord votre approbation, à moins que vous n’activiez l’approbation automatique pour cette routine."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma rotina que enviaria ou adicionaria algo aguarda antes a sua aprovação, a menos que você ative a aprovação automática para ela."
          }
        }
      }
    },
    "A short brief shortly before each calendar meeting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
