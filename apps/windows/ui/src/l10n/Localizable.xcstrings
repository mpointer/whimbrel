    "At least 12 characters. A short sentence you will remember works well. The passphrase locks the recovery file and nothing else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindestens 12 Zeichen. Ein kurzer Satz, den Sie sich merken können, eignet sich gut. Die Passphrase schützt nur die Wiederherstellungsdatei, sonst nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al menos 12 caracteres. Una frase corta que vayas a recordar funciona bien. La frase de contraseña solo protege el archivo de recuperación, nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au moins 12 caractères. Une courte phrase dont vous vous souviendrez convient bien. La phrase secrète verrouille le fichier de récupération, et rien d’autre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au moins 12 caractères. Une courte phrase dont vous vous souviendrez convient bien. La phrase secrète verrouille le fichier de récupération, et rien d’autre."
          }
        },
        "pt" : {
