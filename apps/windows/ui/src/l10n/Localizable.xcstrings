    "Anything older is deleted once a day, along with the recordings that belong to it. A meeting being recorded is never touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ältere Einträge werden einmal täglich gelöscht, samt der zugehörigen Aufnahmen. Ein Meeting, das gerade aufgenommen wird, bleibt unangetastet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que sea más antiguo se elimina una vez al día, junto con las grabaciones que le corresponden. Una reunión que se está grabando nunca se toca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tout élément plus ancien est supprimé une fois par jour, ainsi que les enregistrements associés. Une réunion en cours d'enregistrement n'est jamais touchée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tout ce qui est plus ancien est supprimé une fois par jour, avec les enregistrements qui s’y rattachent. Une réunion en cours d’enregistrement n’est jamais touchée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tudo o que for mais antigo é excluído uma vez por dia, junto com as gravações associadas. Uma reunião em gravação nunca é afetada."
          }
        }
      }
    },
