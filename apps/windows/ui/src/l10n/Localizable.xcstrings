{
  "sourceLanguage" : "en",
  "strings" : {
    "A connected Google Calendar lets Whimbrel offer to record a meeting just before it starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit einem verbundenen Google Calendar kann Whimbrel Ihnen kurz vor Beginn eines Meetings anbieten, es aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un Google Calendar conectado permite que Whimbrel te ofrezca grabar una reunión justo antes de que empiece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un Google Calendar connecté permet à Whimbrel de proposer d'enregistrer une réunion juste avant son début."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un Google Calendar connecté permet à Whimbrel de vous proposer d’enregistrer une réunion juste avant son début."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Com o Google Calendar conectado, o Whimbrel pode oferecer a gravação de uma reunião logo antes de ela começar."
          }
        }
      }
    },
    "A daily cap is a dollar amount, like 2.50. Leave it blank for the default; 0 turns it off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Tageslimit ist ein Dollarbetrag, z. B. 2.50. Leer lassen für den Standardwert; 0 schaltet es aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El límite diario es una cantidad en dólares, como 2.50. Déjalo en blanco para usar el valor predeterminado; 0 lo desactiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un plafond quotidien est un montant en dollars, par exemple 2.50. Laissez vide pour la valeur par défaut ; 0 le désactive."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un plafond quotidien est un montant en dollars, par exemple 2,50. Laissez vide pour la valeur par défaut; 0 le désactive."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O limite diário é um valor em dólares, como 2.50. Deixe em branco para usar o padrão; 0 desativa o limite."
          }
        }
      }
    },
