    "Plus ends {date}. It won't renew." : {
      "shouldTranslate" : false
    },
    "Plus includes a monthly Whimbrel AI allowance. Use it for your AI features?" : {
      "shouldTranslate" : false
    },
    "Plus includes hosted sync on all your devices and a monthly Whimbrel AI allowance. Tax is added at checkout where it applies." : {
      "shouldTranslate" : false
    },
    "Plus tax where applicable. Opens Stripe in your browser. Cloud adds unlimited devices on our sync server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuzüglich Steuern, wo zutreffend. Öffnet Stripe in Ihrem Browser. Cloud erlaubt unbegrenzt viele Geräte auf unserem Sync-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impuestos aplicables aparte. Abre Stripe en tu navegador. Cloud permite dispositivos ilimitados en nuestro servidor de sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxes en sus, le cas échéant. Ouvre Stripe dans votre navigateur. Cloud permet un nombre illimité d’appareils sur notre serveur de synchronisation."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxes en sus, s’il y a lieu. Ouvre Stripe dans votre navigateur. Cloud permet un nombre illimité d’appareils sur notre serveur de synchronisation."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais impostos, quando aplicável. Abre o Stripe no seu navegador. O Cloud permite dispositivos ilimitados no nosso servidor de sincronização."
          }
        }
      }
    },
