    "OpenRouter has no model picked yet, so requests fall back to Ollama. Pick one below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für OpenRouter ist noch kein Modell ausgewählt, daher greifen Anfragen auf Ollama zurück. Wählen Sie unten eines aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OpenRouter aún no tiene un modelo elegido, así que las solicitudes recurren a Ollama. Elige uno abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun modèle n'est encore choisi pour OpenRouter, donc les requêtes basculent sur Ollama. Choisissez-en un ci-dessous."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun modèle n’est encore choisi pour OpenRouter, donc les requêtes se rabattent sur Ollama. Choisissez-en un ci-dessous."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O OpenRouter ainda não tem um modelo escolhido, então as solicitações recorrem ao Ollama. Escolha um abaixo."
          }
        }
      }
    },
    "Opens an email to the Whimbrel team and saves a diagnostics file to attach. It has recent logs and settings status, with email addresses and meeting titles removed. No recordings, transcripts or keys." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffnet eine E-Mail an das Whimbrel-Team und speichert eine Diagnosedatei zum Anhängen. Sie enthält aktuelle Protokolle und den Einstellungsstatus, ohne E-Mail-Adressen und Besprechungstitel. Keine Aufnahmen, Transkripte oder Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre un correo al equipo de Whimbrel y guarda un archivo de diagnóstico para adjuntar. Contiene registros recientes y el estado de la configuración, sin direcciones de correo ni títulos de reuniones. Sin grabaciones, transcripciones ni claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvre un e-mail à l'équipe Whimbrel et enregistre un fichier de diagnostic à joindre. Il contient les journaux récents et l'état des réglages, sans adresses e-mail ni titres de réunion. Aucun enregistrement, transcription ni clé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvre un courriel à l'équipe Whimbrel et enregistre un fichier de diagnostic à joindre. Il contient les journaux récents et l'état des paramètres, sans adresses courriel ni titres de réunion. Aucun enregistrement, transcription ni clé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre um e-mail para a equipe do Whimbrel e salva um arquivo de diagnóstico para anexar. Ele tem registros recentes e o estado das configurações, sem endereços de e-mail nem títulos de reuniões. Sem gravações, transcrições ou chaves."
          }
        }
      }
    },
