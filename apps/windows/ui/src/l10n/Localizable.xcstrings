    "Read meeting transcripts word for word, and let searches include what was said in meetings. This is the most sensitive of the three." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meeting-Transkripte Wort für Wort lesen und Suchen auch das einbeziehen lassen, was in Meetings gesagt wurde. Dies ist die sensibelste der drei Optionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lee las transcripciones de las reuniones palabra por palabra y permite que las búsquedas incluyan lo que se dijo en ellas. Es la opción más sensible de las tres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lire mot à mot les transcriptions de réunion et inclure dans les recherches ce qui a été dit en réunion. C'est le plus sensible des trois."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lire les transcriptions de réunion mot à mot et inclure dans les recherches ce qui a été dit en réunion. C’est le plus sensible des trois."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ler as transcrições das reuniões palavra por palavra e permitir que as buscas incluam o que foi dito nas reuniões. Esta é a mais sensível das três."
          }
        }
      }
    },
