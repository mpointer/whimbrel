// Copy this file to Secrets.xcconfig (same directory) and fill in real
// values. Secrets.xcconfig is gitignored — never commit it.
//
// GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET: from the same
// Google Cloud OAuth client already used by the Calendar connector
// (mcp-servers/google-calendar/) — a "Desktop app" client type. Get
// these from the downloaded client_secret_*.json file's "installed"
// object, or from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID = your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET = your-client-secret

// MICROSOFT_OAUTH_CLIENT_ID: from an Azure AD app registration (Azure Portal ->
// App registrations -> New registration -> "Accounts in any organizational
// directory and personal Microsoft accounts" -> platform type "Mobile and
// desktop applications" -> redirect URI http://localhost). No client secret is
// needed -- this is a public client.
MICROSOFT_OAUTH_CLIENT_ID = your-azure-app-client-id

// SYNC_WORKER_BASE_URL: the Cloudflare Worker's base URL. Deployed at
// https://sync.whimbrelapp.com — use that for real
// sync against the live control-plane/data-plane databases. For local
// Worker-code changes, point at a local `wrangler dev` server instead
// (run `cd server && npx wrangler dev` — defaults to localhost:8787).
// Note the escaped "//" below — xcconfig files treat "//" as a comment
// marker, so a literal "//" in a value must be written as "/$()/" with
// nothing between the parentheses.
SYNC_WORKER_BASE_URL = https:/$()/sync.whimbrelapp.com
