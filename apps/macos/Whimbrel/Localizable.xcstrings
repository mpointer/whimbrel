    "This client will lose access immediately. This can't be undone from here — it would need a brand new token to reconnect." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Client verliert sofort den Zugriff. Das lässt sich von hier aus nicht rückgängig machen – für eine erneute Verbindung wäre ein neues Token nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este cliente perderá el acceso de inmediato. No se puede deshacer desde aquí: necesitaría un token completamente nuevo para volver a conectarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce client perdra immédiatement l'accès. Cette action est irréversible depuis cet écran : un tout nouveau jeton sera nécessaire pour se reconnecter."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce client perdra l’accès immédiatement. Cette action ne peut pas être annulée d’ici : il faudrait un tout nouveau jeton pour se reconnecter."
