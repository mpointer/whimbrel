    "You already have a paid plan." : {
      "comment" : "Shown when checkout is refused because the account is already on a paid plan.",
      "shouldTranslate" : false
    },
    "You are recording. Tell the others before you go on." : {
      "comment" : "Recording notice. An instruction to the user. It must not say or suggest that anyone was told, was notified, agreed or consented.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie nehmen auf. Sagen Sie den anderen Bescheid, bevor Sie weitermachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Estás grabando. Avisa a los demás antes de seguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous enregistrez. Prévenez les autres avant de continuer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
