    "Earlier exports of this client. They are plain copies, yours to keep or delete. An export you moved or renamed is not listed here: delete it yourself." : {
      "comment" : "Client controls (X6, Task 10).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Frühere Exporte dieses Kunden. Es sind einfache Kopien, die Sie behalten oder löschen können. Ein verschobener oder umbenannter Export wird hier nicht aufgeführt: Löschen Sie ihn selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exportaciones anteriores de este cliente. Son copias simples, tuyas para conservar o eliminar. Una exportación que moviste o renombraste no aparece aquí: elimínala tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exports précédents de ce client. Ce sont de simples copies, à conserver ou supprimer à votre guise. Un export déplacé ou renommé n'apparaît pas ici : supprimez-le vous-même."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exportations antérieures de ce client. Ce sont de simples copies, à conserver ou à supprimer à votre guise. Une exportation que vous avez déplacée ou renommée n'est pas listée ici : supprimez-la vous-même."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exportações anteriores deste cliente. São cópias simples, suas para manter ou excluir. Uma exportação que você moveu ou renomeou não aparece aqui: exclua-a você mesmo."
          }
        }
      }
    },
