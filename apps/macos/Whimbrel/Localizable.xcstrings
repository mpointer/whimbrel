      }
    },
    "The recovery key could not be used. Your data has not been changed. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Wiederherstellungsschlüssel ließ sich nicht verwenden. Ihre Daten sind unverändert. Versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
