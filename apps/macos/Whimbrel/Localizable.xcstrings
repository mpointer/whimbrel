    "Leave blank to use the conservative built-in default; set to 0 to explicitly disable that cap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um den vorsichtigen integrierten Standardwert zu verwenden; auf 0 setzen, um dieses Limit ausdrücklich zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo en blanco para usar el valor predeterminado conservador integrado; ponlo en 0 para desactivar explícitamente ese límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour utiliser la valeur par défaut prudente intégrée ; saisissez 0 pour désactiver explicitement cette limite."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour utiliser la valeur par défaut prudente intégrée; indiquez 0 pour désactiver explicitement cette limite."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco para usar o padrão interno conservador; defina como 0 para desativar explicitamente esse limite."
          }
        }
      }
    },
    "Leave out thousands separators and use one decimal mark, like %@." : {
      "comment" : "Shown under a number field in Settings when the text has a thousands separator or could be read two ways. The placeholder is an example number in the person's own format, such as 1250.50.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lassen Sie Tausendertrennzeichen weg und verwenden Sie nur ein Dezimalzeichen, etwa %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Omite los separadores de miles y usa una sola marca decimal, como %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’utilisez pas de séparateur de milliers et utilisez une seule marque décimale, comme %@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’utilisez pas de séparateur de milliers et utilisez une seule marque décimale, comme %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Omita separadores de milhar e use uma só marca decimal, como %@."
          }
        }
      }
    },
