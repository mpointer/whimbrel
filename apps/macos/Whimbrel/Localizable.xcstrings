    },
    "The export failed. Check that the folder can be written to and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export ist fehlgeschlagen. Prüfen Sie, ob der Ordner beschreibbar ist, und versuchen Sie es erneut."
