    },
    "Whimbrel runs with partial access — each permission below unlocks one capability. Grant them one at a time; you can revisit this anytime from the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel läuft mit eingeschränktem Zugriff – jede Berechtigung unten schaltet eine Funktion frei. Erteilen Sie sie nacheinander; Sie können dies jederzeit über die Menüleiste erneut aufrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel funciona con acceso parcial: cada permiso de abajo habilita una función. Concédelos uno a la vez; puedes revisarlos cuando quieras desde la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel fonctionne avec un accès partiel : chaque autorisation ci-dessous active une fonctionnalité. Accordez-les une à une ; vous pouvez y revenir à tout moment depuis la barre des menus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel fonctionne avec un accès partiel : chaque autorisation ci-dessous débloque une fonction. Accordez-les une à la fois; vous pourrez y revenir en tout temps depuis la barre de menus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Whimbrel funciona com acesso parcial: cada permissão abaixo libera um recurso. Conceda uma de cada vez; você pode voltar aqui a qualquer momento pela barra de menus."
          }
        }
      }
    },
