    "Whimbrel uses this to frame summaries, answers, meeting briefs and recaps for you. It follows your routing settings, so Local-only keeps it on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel nutzt dies, um Zusammenfassungen, Antworten, Meeting-Briefings und Recaps für Sie zuzuschneiden. Es folgt Ihren Routing-Einstellungen, sodass bei „Nur lokal“ alles auf diesem Mac bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel usa esto para enfocar tus resúmenes, respuestas, informes de reuniones y recaps. Sigue tu configuración de enrutamiento, así que Solo local lo mantiene en esta Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel s'en sert pour adapter les résumés, les réponses, les briefs de réunion et les recaps. Il suit vos réglages d'acheminement ; avec Local uniquement, tout reste sur ce Mac."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel s’en sert pour adapter vos résumés, réponses, notes de préparation de réunion et recaps. Il suit vos paramètres d’acheminement; avec Local seulement, tout reste sur ce Mac."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
