    "%@ doesn't offer the model %@ to your key. Choose another in Settings → AI Providers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bietet das Modell %2$@ für Ihren Schlüssel nicht an. Wählen Sie unter Einstellungen → KI-Anbieter ein anderes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ doesn't offer the model %2$@ to your key. Choose another in Settings → AI Providers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no ofrece el modelo %2$@ para tu clave. Elige otro en Ajustes → Proveedores de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne propose pas le modèle %2$@ pour votre clé. Choisissez-en un autre dans Réglages → Fournisseurs d’IA."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’offre pas le modèle %2$@ pour votre clé. Choisissez-en un autre dans Réglages → Fournisseurs d'IA."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não oferece o modelo %2$@ para a sua chave. Escolha outro em Configurações → Provedores de IA."
          }
        }
      }
    },
    "%@ has been silent for 3 minutes. Check that the meeting has started and your audio devices are right." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist seit 3 Minuten still. Prüfen Sie, ob das Meeting begonnen hat und ob Ihre Audiogeräte richtig eingestellt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lleva 3 minutos en silencio. Comprueba que la reunión haya empezado y que tus dispositivos de audio sean los correctos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est silencieuse depuis 3 minutes. Vérifiez que la réunion a bien commencé et que vos périphériques audio sont corrects."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est silencieuse depuis 3 minutes. Vérifiez que la réunion a bien commencé et que vos appareils audio sont les bons."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em silêncio há 3 minutos. Verifique se a reunião já começou e se seus dispositivos de áudio estão corretos."
          }
        }
      }
    },
    "%@ has no modifier key, so it would block normal typing. Include Control or Option." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
