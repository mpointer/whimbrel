        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Google sieht, dass die App Ihr Gmail und Ihren Google Kalender liest. Die Daten werden in der Datenbank dieses Macs gespeichert. Sie werden nur an uns weitergegeben, wenn Sie eine auf dieser Seite aufgeführte Funktion aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Google ve que la app lee tu Gmail y tu Google Calendar. Los datos se guardan en la base de datos de esta Mac. Solo nos llegan si activas una función que aparece en esta página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Google voit que l’app lit votre Gmail et votre Google Agenda. Les données sont stockées dans la base de données de ce Mac. Elles ne nous sont transmises que si vous activez une fonction listée sur cette page."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Google voit que l’application lit votre Gmail et votre Google Agenda. Les données sont stockées dans la base de données de ce Mac. Elles ne nous sont transmises que si vous activez une fonction listée sur cette page."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Google vê o app lendo seu Gmail e seu Google Agenda. Os dados ficam no banco de dados deste Mac. Eles só são enviados para nós se você ativar um recurso listado nesta página."
          }
