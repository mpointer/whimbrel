    "This is the only time this token will be shown. Copy it now — Whimbrel only ever stores its hash, so it can't be recovered later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Token wird nur dieses eine Mal angezeigt. Kopieren Sie es jetzt – Whimbrel speichert nur den Hash, daher lässt es sich später nicht wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la única vez que se mostrará este token. Cópialo ahora: Whimbrel solo guarda su hash, así que no se puede recuperar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeton ne sera affiché qu'une seule fois. Copiez-le maintenant : Whimbrel n'en conserve que le hachage, il ne pourra donc pas être récupéré plus tard."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeton ne sera affiché qu’une seule fois. Copiez-le maintenant : Whimbrel ne conserve que son empreinte, il est donc impossible de le récupérer plus tard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é a única vez que este token será exibido. Copie-o agora — o Whimbrel armazena apenas o hash dele, então ele não poderá ser recuperado depois."
          }
        }
      }
    },
