    },
    "The next time Whimbrel starts, it makes a new recovery key with new words." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim nächsten Start erstellt Whimbrel einen neuen Wiederherstellungsschlüssel mit neuen Wörtern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La próxima vez que Whimbrel se inicie, creará una nueva clave de recuperación con palabras nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au prochain démarrage, Whimbrel créera une nouvelle clé de récupération avec de nouveaux mots."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
