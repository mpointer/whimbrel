          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um cliente pode reaparecer como um novo tópico se um novo e-mail ou uma nova reunião corresponder a ele."
          }
        }
      }
    },
    "A hosted model summarised %lld of this client's meetings before. Those summaries stay as they are; from now on they are left out of what Whimbrel sends." : {
      "comment" : "Client controls (X6, Task 10).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein gehostetes Modell hat zuvor %lld Meetings dieses Kunden zusammengefasst. Diese Zusammenfassungen bleiben unverändert; künftig sind sie von dem ausgenommen, was Whimbrel sendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un modelo alojado resumió antes %lld de las reuniones de este cliente. Esos resúmenes se quedan como están; de ahora en adelante se excluyen de lo que Whimbrel envía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un modèle hébergé a déjà résumé %lld réunions de ce client. Ces résumés restent tels quels ; désormais, ils sont exclus de ce que Whimbrel envoie."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un modèle hébergé a résumé %lld des réunions de ce client auparavant. Ces résumés restent tels quels ; à partir de maintenant, ils sont exclus de ce que Whimbrel envoie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um modelo hospedado já resumiu %lld reuniões deste cliente. Esses resumos permanecem como estão; a partir de agora, ficam fora do que o Whimbrel envia."
          }
        }
      }
    },
