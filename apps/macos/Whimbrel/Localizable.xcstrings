    "Leave blank to use the conservative built-in default; set to 0 to explicitly disable that cap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leer lassen, um den vorsichtigen integrierten Standardwert zu verwenden; auf 0 setzen, um dieses Limit ausdrücklich zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Déjalo en blanco para usar el valor predeterminado conservador integrado; ponlo en 0 para desactivar explícitamente ese límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laissez vide pour utiliser la valeur par défaut prudente intégrée ; saisissez 0 pour désactiver explicitement cette limite."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laissez vide pour utiliser la valeur par défaut prudente intégrée; indiquez 0 pour désactiver explicitement cette limite."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deixe em branco para usar o padrão interno conservador; defina como 0 para desativar explicitamente esse limite."
          }
        }
      }
    },
    "Left: couldn't confirm mic and camera were off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verlassen: Mikro und Kamera nicht als aus bestätigt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salida: no se pudo confirmar que mic y cámara estaban apagados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parti : impossible de confirmer micro et caméra coupés"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parti : impossible de confirmer l'arrêt du micro et de la caméra"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saiu: não foi possível confirmar microfone e câmera desligados"
          }
        }
      }
    },
    "Let a local MCP client — an AI assistant, for example — read your Whimbrel data through a scoped, revocable token. Each token is shown once, right after you create it, so save it somewhere safe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlauben Sie einem lokalen MCP-Client, zum Beispiel einem KI-Assistenten, Ihre Whimbrel-Daten über ein eingeschränktes, widerrufbares Token zu lesen. Jedes Token wird nur einmal direkt nach dem Erstellen angezeigt. Speichern Sie es daher sicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que un cliente MCP local, como un asistente de IA, lea tus datos de Whimbrel mediante un token limitado y revocable. Cada token se muestra una sola vez, justo después de crearlo, así que guárdalo en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Autorisez un client MCP local, par exemple un assistant IA, à lire vos données Whimbrel via un jeton limité et révocable. Chaque jeton n’est affiché qu’une seule fois, juste après sa création : conservez-le en lieu sûr."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permettez à un client MCP local (un assistant IA, par exemple) de lire vos données Whimbrel au moyen d’un jeton à portée limitée et révocable. Chaque jeton n’est affiché qu’une seule fois, juste après sa création; conservez-le donc en lieu sûr."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permita que um cliente MCP local, como um assistente de IA, leia seus dados do Whimbrel por meio de um token restrito e revogável. Cada token é exibido uma única vez, logo após a criação, então guarde-o em um local seguro."
          }
        }
      }
    },
    "Let people know you're recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sag den anderen, dass du aufzeichnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avisa a los demás de que estás grabando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prévenez les participants que vous enregistrez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prévenez les participants que vous enregistrez."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avise as pessoas de que você está gravando."
          }
        }
      }
    },
    "Lets Whimbrel alert you when a detected meeting is about to start, even if the app isn't in front." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel kann Sie benachrichtigen, wenn ein erkanntes Meeting gleich beginnt, auch wenn die App nicht im Vordergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que Whimbrel te avise cuando una reunión detectada esté por comenzar, incluso si la app no está en primer plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de vous alerter quand une réunion détectée est sur le point de commencer, même si l’app n’est pas au premier plan."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de vous avertir qu’une réunion détectée est sur le point de commencer, même si l’app n’est pas au premier plan."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que o Whimbrel avise você quando uma reunião detectada estiver prestes a começar, mesmo que o app não esteja em primeiro plano."
          }
        }
      }
    },
    "Lets Whimbrel capture your meetings' system audio (what you hear) — no bot joins the call, and nothing else needs to be installed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel kann den Systemaudio-Ton Ihrer Meetings aufnehmen (was Sie hören). Es tritt kein Bot dem Anruf bei, und es muss nichts weiter installiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que Whimbrel capture el audio del sistema de tus reuniones (lo que escuchas). Ningún bot se une a la llamada y no necesitas instalar nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de capturer l’audio système de vos réunions (ce que vous entendez). Aucun bot ne rejoint l’appel et rien d’autre n’est à installer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de capter l’audio système de vos réunions (ce que vous entendez). Aucun robot ne se joint à l’appel et rien d’autre n’a besoin d’être installé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que o Whimbrel capture o áudio do sistema das suas reuniões (o que você ouve). Nenhum bot entra na chamada e não é preciso instalar mais nada."
          }
        }
      }
    },
    "Lets Whimbrel capture your voice during meetings, on-device, alongside system audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel kann Ihre Stimme während Meetings zusammen mit dem Systemaudio direkt auf dem Gerät aufnehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que Whimbrel capture tu voz durante las reuniones, en el dispositivo, junto con el audio del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de capturer votre voix pendant les réunions, sur l’appareil, en plus de l’audio système."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de capter votre voix pendant les réunions, sur l’appareil, en plus de l’audio système."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que o Whimbrel capture sua voz durante as reuniões, no dispositivo, junto com o áudio do sistema."
          }
        }
      }
    },
    "Lets Whimbrel read the text of your active window to build a searchable timeline — text only, no screenshots." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel kann den Text Ihres aktiven Fensters lesen, um eine durchsuchbare Zeitleiste zu erstellen – nur Text, keine Screenshots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que Whimbrel lea el texto de tu ventana activa para crear una cronología con búsqueda: solo texto, sin capturas de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de lire le texte de votre fenêtre active pour créer une chronologie consultable : texte uniquement, sans captures d’écran."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de lire le texte de votre fenêtre active pour créer une chronologie consultable : texte seulement, aucune capture d’écran."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que o Whimbrel leia o texto da sua janela ativa para criar uma linha do tempo pesquisável. Somente texto, sem capturas de tela."
          }
        }
      }
    },
    "Lets Whimbrel see events with a conferencing link or other attendees, so it can prompt you to record a meeting shortly before it starts (FR-MTG-1)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel kann Termine mit Konferenzlink oder weiteren Teilnehmenden sehen und Sie so kurz vor Beginn zur Aufnahme eines Meetings auffordern (FR-MTG-1)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que Whimbrel vea los eventos con un enlace de videoconferencia u otros asistentes, para que pueda sugerirte grabar una reunión poco antes de que comience (FR-MTG-1)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de voir les événements comportant un lien de visioconférence ou d’autres participants, afin de vous proposer d’enregistrer une réunion peu avant son début (FR-MTG-1)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet à Whimbrel de voir les événements comportant un lien de conférence ou d’autres participants, afin de vous proposer d’enregistrer une réunion peu avant son début (FR-MTG-1)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que o Whimbrel veja eventos com link de conferência ou outros participantes, para sugerir que você grave uma reunião pouco antes de ela começar (FR-MTG-1)."
          }
        }
      }
    },
    "Lets the skin chat in General settings find images on the web, with strict safe-search. Searches count toward the daily spending limit. The key stays on this Mac. Local-only mode blocks it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ermöglicht dem skin-Chat in den Einstellungen unter „Allgemein“, Bilder im Web zu finden, mit strikter Safe-Search. Suchanfragen zählen zum täglichen Ausgabenlimit. Der Schlüssel bleibt auf diesem Mac. Der Modus „Nur lokal“ blockiert dies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que el chat del skin en la configuración General encuentre imágenes en la web, con búsqueda segura estricta. Las búsquedas cuentan para el límite de gasto diario. La clave permanece en este Mac. El modo solo local la bloquea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet au chat du skin, dans les réglages Général, de trouver des images sur le Web avec une recherche sécurisée stricte. Les recherches comptent dans la limite de dépenses quotidienne. La clé reste sur ce Mac. Le mode local uniquement la bloque."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet au clavardage du skin, dans les réglages généraux, de trouver des images sur le web avec une recherche sécurisée stricte. Les recherches comptent dans la limite de dépenses quotidienne. La clé reste sur ce Mac. Le mode local seulement la bloque."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que o chat da skin nas configurações Gerais encontre imagens na web, com busca segura estrita. As buscas contam para o limite de gastos diário. A chave permanece neste Mac. O modo somente local a bloqueia."
          }
        }
      }
    },
