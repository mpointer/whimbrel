        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este cliente perderá o acesso imediatamente. Isso não pode ser desfeito aqui — seria necessário um token totalmente novo para reconectar."
          }
        }
      }
    },
    "This deletes the encrypted copy on the sync server and signs out every device. Nothing on your devices is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dadurch wird die verschlüsselte Kopie auf dem Sync-Server gelöscht und jedes Gerät abgemeldet. Auf Ihren Geräten wird nichts gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
