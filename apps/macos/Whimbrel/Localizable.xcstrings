    "Plan & billing" : {
      "comment" : "Name of the Plan & billing page in Settings and its search entry.",
      "shouldTranslate" : false
    },
    "Plus" : {
      "comment" : "Plan row for a Plus plan with no end date known.",
      "shouldTranslate" : false
    },
    "Plus ends %@. It won't renew." : {
      "comment" : "Plan row on a cancelled Plus plan; %@ is a date.",
      "shouldTranslate" : false
    },
    "Plus includes a monthly Whimbrel AI allowance. Use it for your AI features?" : {
      "comment" : "Title of the one-time sheet asking a Plus account whether to use Whimbrel AI.",
      "shouldTranslate" : false
    },
    "Plus includes hosted sync on all your devices and a monthly Whimbrel AI allowance. Tax is added at checkout where it applies." : {
      "comment" : "Caption under the Plus buttons on the Devices pane.",
      "shouldTranslate" : false
    },
    "Plus isn't available yet. Try again later." : {
      "comment" : "Shown when the Plus checkout is not open yet.",
      "shouldTranslate" : false
    },
    "Plus tax where applicable. Opens Stripe in your browser. Cloud adds unlimited devices on our sync server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuzüglich Steuern, wo zutreffend. Öffnet Stripe in Ihrem Browser. Cloud erlaubt unbegrenzt viele Geräte auf unserem Sync-Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impuestos aplicables aparte. Abre Stripe en tu navegador. Cloud permite dispositivos ilimitados en nuestro servidor de sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxes en sus, le cas échéant. Ouvre Stripe dans votre navigateur. Cloud permet un nombre illimité d’appareils sur notre serveur de synchronisation."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxes en sus, s’il y a lieu. Ouvre Stripe dans votre navigateur. Cloud permet un nombre illimité d’appareils sur notre serveur de synchronisation."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais impostos, quando aplicável. Abre o Stripe no seu navegador. O Cloud permite dispositivos ilimitados no nosso servidor de sincronização."
          }
        }
      }
    },
    "Plus until %@" : {
      "comment" : "Plan row on a Plus plan; %@ is a date.",
      "shouldTranslate" : false
    },
    "Plus: $15 a month or $144 a year. Hosted sync on all your devices and a monthly Whimbrel AI allowance." : {
      "comment" : "Plan & billing, shown while signed out: what the Plus plan costs and includes. Keep the prices in step with the buy buttons.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plus: 15 $ im Monat oder 144 $ im Jahr. Gehostete Synchronisierung auf allen Geräten und ein monatliches Whimbrel-AI-Kontingent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plus: $15 al mes o $144 al año. Sincronización alojada en todos tus dispositivos y una asignación mensual de Whimbrel AI."
