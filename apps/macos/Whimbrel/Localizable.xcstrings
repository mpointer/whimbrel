    "When on, every conversation uses Ollama only, regardless of the provider picked in Ask or Digest. Hosted providers are never called." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn aktiviert, verwendet jede Unterhaltung ausschließlich Ollama, unabhängig vom in Ask oder Digest gewählten Anbieter. Gehostete Anbieter werden nie aufgerufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si está activado, todas las conversaciones usan solo Ollama, sin importar el proveedor elegido en Ask o Digest. Nunca se llama a proveedores alojados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lorsque cette option est activée, chaque conversation utilise uniquement Ollama, quel que soit le fournisseur choisi dans Ask ou la synthèse. Les fournisseurs hébergés ne sont jamais appelés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lorsque cette option est activée, chaque conversation utilise uniquement Ollama, peu importe le fournisseur choisi dans Ask ou Résumé. Les fournisseurs hébergés ne sont jamais appelés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando ativado, todas as conversas usam apenas o Ollama, independentemente do provedor escolhido em Ask ou no Resumo. Provedores hospedados nunca são chamados."
          }
        }
      }
    },
    "When you ask a question, summarize a meeting, or run a routine with a hosted model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn Sie eine Frage stellen, ein Meeting zusammenfassen oder eine Routine mit einem gehosteten Modell ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando haces una pregunta, resumes una reunión o ejecutas una rutina con un modelo alojado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quand vous posez une question, résumez une réunion ou lancez une routine avec un modèle hébergé."
