    "Off (the default)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aus (Standard)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactivado (por defecto)."
          }
        },
        "fr" : {
          "stringUnit" : {
