    "Whimbrel could not finish or undo the encryption it started earlier. Your data is still on this Mac. Try again, and Whimbrel will finish or undo it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel konnte die zuvor begonnene Verschlüsselung weder abschließen noch rückgängig machen. Ihre Daten sind noch auf diesem Mac. Versuchen Sie es erneut, dann schließt Whimbrel sie ab oder macht sie rückgängig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel no pudo terminar ni deshacer el cifrado que empezó antes. Tus datos siguen en esta Mac. Inténtalo de nuevo y Whimbrel lo terminará o lo deshará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel n’a pas pu terminer ni annuler le chiffrement commencé plus tôt. Vos données sont toujours sur ce Mac. Réessayez, et Whimbrel le terminera ou l’annulera."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel n’a pas pu terminer ni annuler le chiffrement commencé plus tôt. Vos données sont toujours sur ce Mac. Réessayez, et Whimbrel le terminera ou l’annulera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Whimbrel não conseguiu concluir nem desfazer a criptografia que começou antes. Seus dados continuam neste Mac. Tente novamente, e o Whimbrel vai concluí-la ou desfazê-la."
          }
        }
      }
    },
