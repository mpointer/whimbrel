    "Otherwise slides are shrunk after %lld days (Settings → Retention). Kept slides stay even if the meeting is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sonst werden Folien nach %lld Tagen verkleinert (Einstellungen → Aufbewahrung). Behaltene Folien bleiben auch, wenn die Besprechung gelöscht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si no, las diapositivas se reducen después de %lld días (Ajustes → Retención). Las diapositivas conservadas se quedan aunque se elimine la reunión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinon, les diapositives sont réduites après %lld jours (Réglages → Conservation). Les diapositives gardées restent même si la réunion est supprimée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinon, les diapositives sont réduites après %lld jours (Réglages → Conservation). Les diapositives gardées restent même si la réunion est supprimée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caso contrário, os slides são reduzidos após %lld dias (Configurações → Retenção). Os slides mantidos continuam mesmo se a reunião for excluída."
