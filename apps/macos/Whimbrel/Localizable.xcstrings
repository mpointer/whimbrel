    "Whimbrel will join the Zoom meetings you can't make, record them and post a short note in the chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel nimmt an Zoom-Meetings teil, die Sie verpassen, zeichnet sie auf und schreibt eine kurze Notiz in den Chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel se unirá a las reuniones de Zoom a las que no puedas asistir, las grabará y publicará una nota breve en el chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel rejoindra les réunions Zoom auxquelles vous ne pouvez pas assister, les enregistrera et publiera une courte note dans le chat."
