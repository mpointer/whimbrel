          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gravando como nova reunião"
          }
        }
      }
    },
    "Recording files with no matching meeting record at all — e.g. from a crashed or interrupted session. Retention above only removes files for meetings it actually deletes; this finds files that were never tracked by any meeting in the first place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aufnahmedateien ohne zugehörigen Meeting-Eintrag, z. B. aus einer abgestürzten oder unterbrochenen Sitzung. Die Aufbewahrung oben entfernt nur Dateien von Meetings, die sie tatsächlich löscht; hier finden Sie Dateien, die nie einem Meeting zugeordnet waren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Archivos de grabación sin ningún registro de reunión correspondiente, por ejemplo, de una sesión que se cerró o se interrumpió. La retención de arriba solo elimina los archivos de las reuniones que borra; esto encuentra archivos que ninguna reunión registró desde un principio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fichiers d'enregistrement sans aucune réunion correspondante, par ex. à la suite d'un plantage ou d'une session interrompue. La conservation ci-dessus ne supprime que les fichiers des réunions qu'elle supprime réellement ; ceci détecte les fichiers qui n'ont jamais été associés à une réunion."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fichiers d’enregistrement sans aucune fiche de réunion correspondante, p. ex. à la suite d’une session plantée ou interrompue. La conservation ci-dessus ne supprime que les fichiers des réunions qu’elle supprime réellement; cette option trouve les fichiers qui n’ont jamais été associés à une réunion."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arquivos de gravação sem nenhum registro de reunião correspondente, por exemplo de uma sessão que travou ou foi interrompida. A retenção acima só remove arquivos de reuniões que ela realmente exclui; aqui são encontrados arquivos que nunca foram associados a nenhuma reunião."
          }
        }
      }
    },
