    "Each data class has its own retention window; hard-deletes rows older than it (propagates to the search indexes too)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Datenklasse hat eine eigene Aufbewahrungsdauer; ältere Einträge werden endgültig gelöscht (auch aus den Suchindizes)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada clase de datos tiene su propio periodo de retención; los registros más antiguos se eliminan de forma definitiva (también en los índices de búsqueda)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque catégorie de données a sa propre durée de conservation ; les lignes plus anciennes sont supprimées définitivement (y compris dans les index de recherche)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque catégorie de données a sa propre période de conservation; les lignes plus anciennes sont supprimées définitivement (y compris dans les index de recherche)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada classe de dados tem sua própria janela de retenção; linhas mais antigas que ela são excluídas permanentemente (isso também se propaga para os índices de busca)."
          }
        }
      }
    },
