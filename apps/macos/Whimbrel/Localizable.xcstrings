    "At least 12 characters. A short sentence you will remember works well. The passphrase locks the recovery file and nothing else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mindestens 12 Zeichen. Ein kurzer Satz, den Sie sich merken können, eignet sich gut. Die Passphrase schützt die Wiederherstellungsdatei und sonst nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al menos 12 caracteres. Una frase corta que vayas a recordar funciona bien. La frase de contraseña protege el archivo de recuperación y nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au moins 12 caractères. Une courte phrase dont vous vous souviendrez convient bien. La phrase secrète protège le fichier de récupération et rien d’autre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au moins 12 caractères. Une courte phrase dont vous vous souviendrez convient bien. La phrase secrète protège le fichier de récupération et rien d’autre."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pelo menos 12 caracteres. Uma frase curta que você vai lembrar funciona bem. A frase secreta protege o arquivo de recuperação e nada mais."
          }
        }
      }
    },
    "At or over the monthly budget." : {
