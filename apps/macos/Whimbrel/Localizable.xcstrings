    "This will permanently delete %lld duplicate meeting(s) — the most recently applied copy in each group is kept. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden %lld doppelte Meeting(s) dauerhaft gelöscht – die zuletzt angewendete Kopie jeder Gruppe bleibt erhalten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará de forma permanente %lld reunión(es) duplicada(s); se conserva la copia aplicada más recientemente de cada grupo. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement %lld réunion(s) en double ; la copie appliquée le plus récemment dans chaque groupe est conservée. Cette action est irréversible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera définitivement %lld réunion(s) en double. La copie appliquée le plus récemment dans chaque groupe est conservée. Cette action est irréversible."
          }
