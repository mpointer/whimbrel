          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel ne supprimera pas et ne remplacera pas votre bibliothèque. Elle reste sur ce Mac, inchangée, jusqu’à ce que vous la déverrouilliez."
          }
        },
        "fr-CA" : {
