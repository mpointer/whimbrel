    "%@ has been silent for 3 minutes. Check that the meeting has started and your audio devices are right." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist seit 3 Minuten still. Prüfe, ob das Meeting begonnen hat und ob deine Audiogeräte richtig eingestellt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ lleva 3 minutos en silencio. Comprueba que la reunión haya empezado y que tus dispositivos de audio sean los correctos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est silencieuse depuis 3 minutes. Vérifiez que la réunion a bien commencé et que vos périphériques audio sont corrects."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est silencieuse depuis 3 minutes. Vérifiez que la réunion a bien commencé et que vos appareils audio sont les bons."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está em silêncio há 3 minutos. Verifique se a reunião já começou e se seus dispositivos de áudio estão corretos."
          }
        }
