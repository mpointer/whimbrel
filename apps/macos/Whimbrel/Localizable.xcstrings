      }
    },
    "This skin is too big to export (more than 64 MB or 200 files), so it couldn't be imported again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Skin ist zu groß für den Export (mehr als 64 MB oder 200 Dateien) und konnte daher nicht erneut importiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este skin es demasiado grande para exportarlo (más de 64 MB o 200 archivos), así que no se podría volver a importar."
          }
        },
        "fr" : {
