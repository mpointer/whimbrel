    "This month's AI allowance is used up." : {
      "comment" : "Whimbrel AI card on Plus: allowance used up, prepaid credit left, plan will not renew.",
      "shouldTranslate" : false
    },
    "This month's AI allowance is used up. Add credit or choose another model in Settings." : {
      "comment" : "Whimbrel AI card on Plus with no allowance and no prepaid credit left.",
      "shouldTranslate" : false
    },
    "This month's AI allowance is used up. Your allowance renews with your plan." : {
      "comment" : "Whimbrel AI card on Plus: allowance used up, prepaid credit left, plan renews.",
      "shouldTranslate" : false
    },
    "This month: %@" : {
