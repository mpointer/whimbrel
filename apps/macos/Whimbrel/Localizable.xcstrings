    "Whimbrel Cloud holds your sync key. While this runs it can read your %@. It keeps nothing after the run." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel Cloud hält Ihren Sync-Schlüssel. Während der Ausführung kann es Folgendes lesen: %@. Nach der Ausführung speichert es nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel Cloud guarda tu clave de sincronización. Mientras se ejecuta, puede leer tu %@. No conserva nada después de la ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel Cloud détient votre clé de synchronisation. Pendant l'exécution, il peut lire vos %@. Il ne conserve rien après l'exécution."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel Cloud détient votre clé de synchronisation. Pendant l'exécution, il peut lire vos %@. Il ne conserve rien après l'exécution."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Whimbrel Cloud guarda sua chave de sincronização. Enquanto isso é executado, ele pode ler: %@. Ele não guarda nada após a execução."
          }
        }
      }
    },
