    "Pages on these sites, and their subdomains, are dropped before anything is saved. Works in browsers that expose the page address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seiten dieser Websites und ihrer Subdomains werden verworfen, bevor etwas gespeichert wird. Funktioniert in Browsern, die die Seitenadresse bereitstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las páginas de estos sitios y de sus subdominios se descartan antes de guardar nada. Funciona en los navegadores que exponen la dirección de la página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les pages de ces sites et de leurs sous-domaines sont écartées avant que quoi que ce soit soit enregistré. Fonctionne dans les navigateurs qui exposent l’adresse de la page."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les pages de ces sites et de leurs sous-domaines sont écartées avant que quoi que ce soit soit enregistré. Fonctionne dans les navigateurs qui exposent l’adresse de la page."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As páginas desses sites e de seus subdomínios são descartadas antes de qualquer coisa ser salva. Funciona em navegadores que expõem o endereço da página."
          }
        }
      }
    },
    "Pages on these sites, and their subdomains, are skipped before any text is read. Works in browsers that expose the page address." : {
