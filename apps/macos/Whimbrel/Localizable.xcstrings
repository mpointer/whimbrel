          }
        }
      }
    },
    "When on, every conversation uses Ollama only, regardless of the provider picked in Ask or Digest. Hosted providers are never called." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, verwendet jede Unterhaltung ausschließlich Ollama, unabhängig vom in Ask oder Digest gewählten Anbieter. Gehostete Anbieter werden nie aufgerufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, todas las conversaciones usan solo Ollama, sin importar el proveedor elegido en Ask o Digest. Nunca se llama a proveedores alojados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, chaque conversation utilise uniquement Ollama, quel que soit le fournisseur choisi dans Ask ou Résumé. Les fournisseurs hébergés ne sont jamais appelés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, chaque conversation utilise uniquement Ollama, peu importe le fournisseur choisi dans Ask ou Synthèse. Les fournisseurs hébergés ne sont jamais appelés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, todas as conversas usam apenas o Ollama, independentemente do provedor escolhido em Ask ou no Resumo. Provedores hospedados nunca são chamados."
          }
        }
      }
    },
    "When the app starts, then once a day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Start der App, danach einmal täglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir la app y luego una vez al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au lancement de l’app, puis une fois par jour."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au lancement de l’app, puis une fois par jour."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o app abre e depois uma vez por dia."
