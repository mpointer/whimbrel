          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada foi enviado. A resposta não viria mais de onde o botão Ask indicava. O botão agora mostra de onde ela viria. Confira e pergunte de novo."
