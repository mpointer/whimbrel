    "Open Whimbrel on a device that's already signed in, go to Settings → Devices, and approve this one — it'll be picked up automatically within a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffnen Sie Whimbrel auf einem bereits angemeldeten Gerät, gehen Sie zu Einstellungen → Geräte und genehmigen Sie dieses Gerät. Es wird innerhalb weniger Sekunden automatisch erkannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre Whimbrel en un dispositivo que ya haya iniciado sesión, ve a Configuración → Dispositivos y aprueba este. Se detectará automáticamente en unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez Whimbrel sur un appareil déjà connecté, allez dans Paramètres → Appareils, puis approuvez celui-ci. Il sera détecté automatiquement en quelques secondes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez Whimbrel sur un appareil déjà connecté, allez dans Réglages → Appareils, puis approuvez celui-ci. Il sera détecté automatiquement en quelques secondes."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abra o Whimbrel em um dispositivo que já esteja conectado, vá em Configurações → Dispositivos e aprove este. Ele será reconhecido automaticamente em alguns segundos."
          }
        }
      }
    },
