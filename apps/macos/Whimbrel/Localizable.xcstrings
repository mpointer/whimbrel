    "Recording as a New Meeting" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aufnahme als neues Meeting"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grabando como reunión nueva"
          }
        },
