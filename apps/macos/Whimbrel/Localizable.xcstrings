          }
        }
      }
    },
    "A meeting slide" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Meeting-Folie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una diapositiva de reunión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une diapositive de réunion"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une diapositive de réunion"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um slide de reunião"
          }
        }
      }
    },
    "A qualifying calendar meeting has a conferencing link (Zoom/Meet/Teams/Webex) or at least one other attendee. Upcoming meetings and the recording prompt itself are shown in the main window, not here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein qualifizierendes Kalender-Meeting hat einen Konferenzlink (Zoom/Meet/Teams/Webex) oder mindestens einen weiteren Teilnehmer. Anstehende Meetings und die Aufnahmeaufforderung selbst erscheinen im Hauptfenster, nicht hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una reunión de calendario que califica tiene un enlace de videoconferencia (Zoom/Meet/Teams/Webex) o al menos otro asistente. Las próximas reuniones y el aviso de grabación se muestran en la ventana principal, no aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une réunion de calendrier éligible comporte un lien de visioconférence (Zoom/Meet/Teams/Webex) ou au moins un autre participant. Les réunions à venir et l'invite d'enregistrement s'affichent dans la fenêtre principale, pas ici."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une réunion d’agenda admissible comporte un lien de conférence (Zoom/Meet/Teams/Webex) ou au moins un autre participant. Les réunions à venir et l’invite d’enregistrement s’affichent dans la fenêtre principale, pas ici."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma reunião de calendário qualificada tem um link de conferência (Zoom/Meet/Teams/Webex) ou pelo menos outro participante. As próximas reuniões e o próprio aviso de gravação aparecem na janela principal, não aqui."
          }
        }
      }
    },
    "A random identifier that changes every week, the platform and the app version, so we can count installs. It is not linked to you, your account or your devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine zufällige Kennung, die sich jede Woche ändert, die Plattform und die App-Version, damit wir Installationen zählen können. Sie ist weder mit Ihnen noch mit Ihrem Account oder Ihren Geräten verknüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un identificador aleatorio que cambia cada semana, la plataforma y la versión de la app, para contar instalaciones. No está vinculado a ti, a tu cuenta ni a tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un identifiant aléatoire qui change chaque semaine, la plateforme et la version de l'app, pour compter les installations. Il n'est lié ni à vous, ni à votre compte, ni à vos appareils."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un identifiant aléatoire qui change chaque semaine, la plateforme et la version de l'app, pour compter les installations. Il n'est lié ni à vous, ni à votre compte, ni à vos appareils."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um identificador aleatório que muda toda semana, a plataforma e a versão do app, para contarmos instalações. Ele não está ligado a você, à sua conta nem aos seus dispositivos."
          }
        }
      }
    },
    "A routine result" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Routine-Ergebnis"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un resultado de rutina"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un résultat de routine"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un résultat de routine"
          }
        },
        "pt" : {
          "stringUnit" : {
