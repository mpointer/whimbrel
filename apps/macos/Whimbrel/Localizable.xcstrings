    "Whimbrel could not restart by itself. Quit Whimbrel and open it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel konnte sich nicht selbst neu starten. Beenden Sie Whimbrel und öffnen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
