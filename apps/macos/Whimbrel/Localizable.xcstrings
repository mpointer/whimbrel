    "This needs help from support. Quit Whimbrel, leave the Whimbrel folder in Application Support as it is, and write to hello@whimbrelapp.com." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hierfür ist Hilfe vom Support nötig. Beenden Sie Whimbrel, lassen Sie den Ordner Whimbrel in Application Support unverändert und schreiben Sie an hello@whimbrelapp.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto necesita ayuda del soporte. Cierra Whimbrel, deja la carpeta Whimbrel de Application Support como está y escribe a hello@whimbrelapp.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il faut l’aide de l’assistance. Quittez Whimbrel, laissez le dossier Whimbrel d’Application Support tel quel et écrivez à hello@whimbrelapp.com."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il faut l’aide du soutien technique. Quittez Whimbrel, laissez le dossier Whimbrel d’Application Support tel quel et écrivez à hello@whimbrelapp.com."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isso precisa da ajuda do suporte. Feche o Whimbrel, deixe a pasta Whimbrel em Application Support como está e escreva para hello@whimbrelapp.com."
          }
        }
      }
    },
    "This palette is dark only, so it always uses Dark." : {
