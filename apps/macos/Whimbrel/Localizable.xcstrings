    },
    "Whimbrel works with only some of these turned on. Each one adds one thing. Turn them on one at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel funktioniert auch, wenn nur einige davon aktiviert sind. Jede Freigabe bringt eine Funktion. Aktivieren Sie sie nacheinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
