    "A meeting is currently recording" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Meeting wird gerade aufgenommen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se está grabando una reunión"
          }
        },
        "fr" : {
