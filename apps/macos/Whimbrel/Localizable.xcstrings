    },
    "Whimbrel works without any AI model: capture, transcripts and search still work. Chat, summaries and routines need one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel funktioniert auch ohne KI-Modell: Aufnahme, Transkripte und Suche funktionieren weiterhin. Chat, Zusammenfassungen und Routinen benötigen eines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel funciona sin ningún modelo de IA: la captura, las transcripciones y la búsqueda siguen funcionando. El chat, los resúmenes y las rutinas necesitan uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whimbrel fonctionne sans modèle d'IA : la capture, les transcriptions et la recherche restent disponibles. Le chat, les résumés et les routines en nécessitent un."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
