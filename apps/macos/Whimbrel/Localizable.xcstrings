    "Ask a question about your captured timeline, answered %@, with citations back to specific items. Follow-up questions see the earlier exchange, so \"what about the other one?\" works." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stellen Sie eine Frage zu Ihrer aufgezeichneten Timeline, beantwortet %@, mit Quellenangaben zu bestimmten Einträgen. Folgefragen berücksichtigen den bisherigen Austausch, daher funktioniert „Und was ist mit dem anderen?“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz una pregunta sobre tu cronología capturada, con respuesta %@ y citas que remiten a elementos específicos. Las preguntas de seguimiento ven el intercambio anterior, así que \"¿y el otro?\" funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posez une question sur votre chronologie capturée ; la réponse est fournie %@, avec des citations renvoyant à des éléments précis. Les questions de suivi tiennent compte de l’échange précédent, donc « et l’autre ? » fonctionne."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posez une question sur votre chronologie saisie. La réponse est fournie %@, avec des citations renvoyant à des éléments précis. Les questions de suivi tiennent compte de l'échange précédent, donc « et l'autre ? » fonctionne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faça uma pergunta sobre sua linha do tempo capturada, respondida %@, com citações de itens específicos. As perguntas seguintes consideram a conversa anterior, então \"e o outro?\" funciona."
          }
        }
      }
    },
