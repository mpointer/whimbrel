          }
        }
      }
    },
    "Whimbrel will not delete or replace this database. It stays on this Mac, unchanged, until you unlock it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel wird diese Datenbank weder löschen noch ersetzen. Sie bleibt unverändert auf diesem Mac, bis Sie sie entsperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel no eliminará ni reemplazará esta base de datos. Se queda en esta Mac, sin cambios, hasta que la desbloquees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel ne supprimera pas et ne remplacera pas cette base de données. Elle reste sur ce Mac, inchangée, jusqu’à ce que vous la déverrouilliez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Whimbrel ne supprimera pas et ne remplacera pas cette base de données. Elle reste sur ce Mac, inchangée, jusqu’à ce que vous la déverrouilliez."
          }
        },
        "pt" : {
          "stringUnit" : {
