    },
    "On this Mac, summaries, suggestions, people and organisations that Whimbrel made and that name this client are deleted too." : {
      "comment" : "Client controls (X6). Delete screen and receipt: derived text removed on this computer only.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auf diesem Mac werden auch Zusammenfassungen, Vorschläge, Personen und Organisationen gelöscht, die Whimbrel erstellt hat und die diesen Kunden nennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En esta Mac, también se eliminan los resúmenes, sugerencias, personas y organizaciones que Whimbrel creó y que mencionan a este cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sur ce Mac, les résumés, suggestions, personnes et organisations créés par Whimbrel qui mentionnent ce client sont aussi supprimés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sur ce Mac, les résumés, suggestions, personnes et organisations créés par Whimbrel qui nomment ce client sont aussi supprimés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neste Mac, resumos, sugestões, pessoas e organizações que o Whimbrel criou e que citam este cliente também são excluídos."
          }
        }
      }
    },
