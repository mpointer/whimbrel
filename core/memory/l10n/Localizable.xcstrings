    "Which recurring meetings can I kill? Look for meetings that keep happening but don't seem to produce decisions or action items.": {
      "comment": "Not stored: the question an Ask starter chip sends (api::prompts::starter_prompts).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf welche Serientermine kann ich verzichten? Suchen Sie nach Meetings, die immer wieder stattfinden, aber offenbar keine Entscheidungen oder Aufgaben hervorbringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Qué reuniones recurrentes puedo eliminar? Busca reuniones que siguen ocurriendo pero que no parecen producir decisiones ni tareas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quelles réunions récurrentes puis-je supprimer ? Cherche les réunions qui se répètent sans produire de décisions ni d’actions à mener."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quelles réunions récurrentes puis-je abolir ? Cherchez les réunions qui reviennent sans sembler produire de décisions ni d’actions à faire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quais reuniões recorrentes posso cancelar? Procure reuniões que continuam acontecendo, mas não parecem gerar decisões ou tarefas."
          }
        }
      }
    },
