    "Calendar isn't connected, or needs to be reconnected. Check Settings → Connectors, then try Approve again.": {
      "comment": "Not stored: transient message core renders in English only; the shells localize it by code (Task 4).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Kalender ist nicht verbunden oder muss neu verbunden werden. Prüfen Sie Einstellungen → Connectors und versuchen Sie dann erneut, zu genehmigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Calendar no está conectado o necesita reconectarse. Revisa Ajustes → Conectores y vuelve a intentar Aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le calendrier n'est pas connecté ou doit être reconnecté. Vérifiez Paramètres → Connecteurs, puis appuyez de nouveau sur Approuver."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le calendrier n'est pas connecté, ou doit être reconnecté. Vérifiez Réglages → Connecteurs, puis réessayez d'approuver."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Calendário não está conectado ou precisa ser reconectado. Verifique Configurações → Conectores e tente aprovar novamente."
          }
        }
      }
    },
    "Confirm that you want to start fresh to continue.": {
      "comment": "Not stored: transient message core renders in English only; the shells localize it by code (Task 4).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bestätigen Sie, dass Sie neu beginnen möchten, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirma que quieres empezar de cero para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirmez que vous souhaitez repartir de zéro pour continuer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirmez que vous voulez repartir à zéro pour continuer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirme que você quer começar do zero para continuar."
          }
        }
      }
    },
    "Couldn't complete this action just now ({reason}). It's still pending -- try Approve again in a bit.": {
      "comment": "Not stored: transient message core renders in English only; the shells localize it by code (Task 4).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Aktion konnte gerade nicht abgeschlossen werden ({reason}). Sie steht weiterhin aus – versuchen Sie es in Kürze erneut mit Genehmigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo completar esta acción en este momento ({reason}). Sigue pendiente; vuelve a intentar Aprobar en un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de terminer cette action pour le moment ({reason}). Elle est toujours en attente ; réessayez d'approuver dans un instant."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de terminer cette action pour le moment ({reason}). Elle est toujours en attente -- réessayez d'approuver dans un instant."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível concluir esta ação agora ({reason}). Ela continua pendente; tente aprovar novamente daqui a pouco."
          }
        }
      }
    },
    "Couldn't reach the sync server. Check your connection and try again.": {
      "comment": "Not stored: transient message core renders in English only; the shells localize it by code (Task 4).",
      "localizations": {
        "de": {
