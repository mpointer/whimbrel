    "Hi {first_name},\n\nI couldn't join {title} on {day}. Could you share the recording or transcript when you have a moment?\n\nThanks,\n{signature}": {
      "comment": "Stored: Away Mode email body in the pending routine run's action payload; sent to the organizer. {day} is a localized weekday and date; {signature} is the user's name.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hallo {first_name},\n\nich konnte am {day} nicht an {title} teilnehmen. Könnten Sie mir die Aufzeichnung oder das Transkript schicken, wenn Sie einen Moment Zeit haben?\n\nVielen Dank,\n{signature}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hola {first_name},\n\nNo pude unirme a {title} el {day}. ¿Podrías compartirme la grabación o la transcripción cuando tengas un momento?\n\nGracias,\n{signature}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bonjour {first_name},\n\nJe n’ai pas pu participer à {title} le {day}. Pourriez-vous partager l’enregistrement ou la transcription quand vous aurez un moment ?\n\nMerci,\n{signature}"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bonjour {first_name},\n\nJe n’ai pas pu me joindre à {title} le {day}. Pourriez-vous me transmettre l’enregistrement ou la transcription quand vous aurez un instant ?\n\nMerci,\n{signature}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Olá, {first_name},\n\nNão consegui participar de {title} em {day}. Você poderia compartilhar a gravação ou a transcrição quando tiver um momento?\n\nObrigado,\n{signature}"
          }
        }
      }
    },
    "Is there a trend across my meetings this week — recurring topics, blockers, or themes?": {
      "comment": "Not stored: the question an Ask starter chip sends (api::prompts::starter_prompts).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gibt es einen Trend in meinen Meetings dieser Woche – wiederkehrende Themen, Blocker oder Muster?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
