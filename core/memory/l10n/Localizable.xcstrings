        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível acessar o servidor de sincronização. Verifique sua conexão e tente novamente."
          }
        }
      }
    },
    "Couldn't reach {provider}. The key is saved; models will load when you're online.": {
