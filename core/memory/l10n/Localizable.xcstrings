    "Ask {organizer} for the recording of {title}": {
      "comment": "Stored: meeting_followup.text, the Away Mode to-do (api::away_followup). {organizer} is a name, an email or 'the organizer'.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "{organizer} nach der Aufzeichnung von {title} fragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pedirle a {organizer} la grabación de {title}"
          }
        },
