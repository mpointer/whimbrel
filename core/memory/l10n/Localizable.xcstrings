    "What's quietly slipping? Look across my recent meetings and captures for things that keep getting mentioned but never resolved.": {
      "comment": "Not stored: the question an Ask starter chip sends (api::prompts::starter_prompts).",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Was gerät unbemerkt ins Rutschen? Prüfen Sie meine letzten Meetings und Aufnahmen auf Dinge, die immer wieder erwähnt, aber nie geklärt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Qué se está descuidando en silencio? Revisa mis reuniones y capturas recientes en busca de cosas que se mencionan una y otra vez, pero nunca se resuelven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qu’est-ce qui prend discrètement du retard ? Parcours mes réunions et captures récentes pour trouver ce qui revient sans cesse sans jamais être réglé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qu’est-ce qui passe sous le radar ? Examinez mes réunions et mes saisies récentes à la recherche de sujets souvent mentionnés mais jamais résolus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O que está escapando em silêncio? Procure nas minhas reuniões e capturas recentes coisas que sempre são mencionadas, mas nunca resolvidas."
          }
        }
      }
    },
