        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Approuvez cet ordinateur sur votre autre appareil ; il a été actif au cours de la dernière semaine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aprove este computador no seu outro dispositivo; ele esteve ativo na última semana."
          }
        }
      }
    },
