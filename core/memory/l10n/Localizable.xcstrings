          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo conectar con el servidor de sincronización. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de joindre le serveur de synchronisation. Vérifiez votre connexion et réessayez."
