{
  "sourceLanguage": "en",
  "strings": {
    "%A, %B %-d": {
      "comment": "Not prose: a chrono strftime pattern for the meeting day inside the stored Away Mode email ({day}). Keep every %-field; reorder them and add words for the language (es \"%A, %-d de %B\", fr \"%A %-d %B\"). Weekday and month names come from the locale.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%A, %-d. %B"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%A, %-d %B"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%A, %-d %B"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%A, %-d de %B"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%A %-d %B"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%A %-d %B"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%A, %-d de %B"
          }
        }
      }
    },
    "(no subject)": {
      "comment": "Stored: inside the Reply Priorities routine_run.output_summary, for an email thread with no subject.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(kein Betreff)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(sin asunto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(sans objet)"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(sans objet)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "(sem assunto)"
          }
        }
      }
    },
    "Added \"{title}\" to your calendar.": {
      "comment": "Stored: routine_run.output_summary after a calendar event is created (api::write_action). {title} is the event title.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„{title}“ zu Ihrem Kalender hinzugefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se agregó \"{title}\" a tu calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« {title} » ajouté à votre calendrier."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« {title} » ajouté à votre calendrier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"{title}\" foi adicionado à sua agenda."
          }
        }
      }
    },
    "Any trend this week?": {
      "comment": "Not stored: an Ask starter chip title (api::prompts::starter_prompts).",
